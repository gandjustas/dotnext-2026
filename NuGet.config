<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      Modulith is not on nuget.org yet. This points at a local pack of the sibling repository:
        cd ../modulith && dotnet pack src/Modulith/Modulith.csproj -c Release -o local-feed
    -->
    <add key="modulith-local" value="D:\Projects\modulith\local-feed" />
  </packageSources>
</configuration>
