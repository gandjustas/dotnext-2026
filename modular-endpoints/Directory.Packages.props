<Project>
    <ItemGroup>
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.7" />
        <PackageVersion Include="TUnit" Version="1.44.0" />
    </ItemGroup>
    <!--
        The base class, the analyzers and the MSBuild conventions now arrive as one package
        instead of two vendored projects.
    -->
    <ItemGroup>
        <PackageVersion Include="Modulith" Version="0.0.0-preview.0.10" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Modulith" />
    </ItemGroup>
</Project>