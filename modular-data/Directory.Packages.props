<Project>
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.5.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="TUnit" Version="1.81.10" />
    <PackageVersion Include="TUnit.AspNetCore" Version="1.81.10" />
    <!-- тестам: реляционные метаданные модели (схема, таблица), той же версии, что у Web через Design -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.7" />
  </ItemGroup>
  <!--
    Базовый класс модуля, анализаторы и MSBuild-конвенции — один пакет вместо двух проектов
    module-base и modular-analyzer. FusionModules.EntityFrameworkCore собирает модель AppContext
    из загруженных модулей и кеширует её по набору модулей (Web/Program.cs).
  -->
  <ItemGroup>
    <PackageVersion Include="FusionModules" Version="0.3.0" />
    <!-- тестам: настройка хоста топологии и маршруты по модулям; фабрика — TUnit.AspNetCore -->
    <PackageVersion Include="FusionModules.Testing" Version="0.3.0" />
    <PackageVersion Include="FusionModules.EntityFrameworkCore" Version="0.3.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FusionModules" />
  </ItemGroup>
</Project>
