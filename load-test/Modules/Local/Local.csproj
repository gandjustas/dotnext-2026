<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Plain Microsoft.NET.Sdk, not Microsoft.NET.Sdk.Web with OutputType=Library: типы ASP.NET
      модуль берёт из общего фреймворка, который приносит пакет FusionModules, а неявные using
      Web SDK возвращает FusionModules.targets. Имя сборки — та самая строка, которую топология
      пишет в HOSTINGSTARTUPASSEMBLIES.
    -->
    <AssemblyName>Local</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Contracts\Contracts.csproj" />
  </ItemGroup>

</Project>
