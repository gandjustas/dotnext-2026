<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="EasyNetQ" Version="8.1.2" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.76.0" />
    <PackageVersion Include="Grpc.Core" Version="2.46.6" />
    <PackageVersion Include="Grpc.Net.ClientFactory" Version="2.76.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.5.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="TUnit" Version="1.81.10" />
    <PackageVersion Include="TUnit.AspNetCore" Version="1.81.10" />
  </ItemGroup>

  <!--
    Базовый класс модуля, анализаторы и MSBuild-конвенции — один пакет вместо двух проектов
    module-base и modular-analyzer.
  -->
  <ItemGroup>
    <PackageVersion Include="FusionModules" Version="0.3.0" />
    <!-- тестам: настройка хоста топологии и маршруты по модулям; фабрика — TUnit.AspNetCore -->
    <PackageVersion Include="FusionModules.Testing" Version="0.3.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FusionModules" />
  </ItemGroup>
</Project>
