<Project Sdk="Microsoft.NET.Sdk.Web">



  <PropertyGroup>
    <UserSecretsId>2c061ef0-b94e-438d-ae03-ba5323a04ce2</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <!--
    Все четыре транспорта регистрируют ICalculator — намеренно: это четыре реализации одного ребра
    Web → калькулятор, и ни одна топология из docker-compose.yml не грузит два сразу. Сборка этого
    знать не может, поэтому MOD0014 сказано здесь. Топологию, которая всё-таки назовёт два транспорта,
    остановит проверка при старте, и ValidateModules(), сгенерированный из этого списка, назовёт их
    альтернативами.
  -->
  <PropertyGroup>
    <fusion_modules_allowed_service_collisions>Contracts.ICalculator</fusion_modules_allowed_service_collisions>
  </PropertyGroup>



  <ItemGroup>
    <ProjectReference Include="..\Contracts\Contracts.csproj" />
    <ProjectReference Include="..\Modules\Local\Local.csproj" />
    <ProjectReference Include="..\Modules\RemoteGrpc\RemoteGrpc.csproj" />
    <ProjectReference Include="..\Modules\RemoteRest\RemoteRest.csproj" />
    <ProjectReference Include="..\Modules\RemoteRmq\RemoteRmq.csproj" />
  </ItemGroup>



  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
  </ItemGroup>

</Project>
